# Chardsoft Router OS: announces chaos-router.local and the app names over
# mDNS (deploy/mdns-publish.sh). Installed by deploy/install-service.sh,
# which fills in @USER@, @APP_DIR@ and @STATE_DIR@.

[Unit]
Description=Chardsoft Router OS: .local names over mDNS
Documentation=https://github.com/chaoscent/chardsoft-router-os
After=avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=@USER@
ExecStart=@APP_DIR@/deploy/mdns-publish.sh @STATE_DIR@/system/mdns_names.txt
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
